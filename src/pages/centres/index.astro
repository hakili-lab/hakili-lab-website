---
// Liste des centres Hakili Lab (une carte par centre pretPourPublication,
// tries alphabetiquement), avec balisage JSON-LD ItemList.
import { Picture } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE_URL } from '../../data/site.js';
import { centres as allCentres } from '../../data/centres.js';

const centres = [...allCentres].sort((a, b) => a.nom.localeCompare(b.nom, 'fr'));
const centresPrets = centres.filter((c) => c.pretPourPublication);

// Seuls les centres publies ont une page a referencer.
const itemListJsonLd =
  centresPrets.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        itemListElement: centresPrets.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: `Hakili Lab (${c.nom})`,
          url: `${SITE_URL}/centres/${c.slug}`,
        })),
      }
    : undefined;
---
<SiteLayout
  title="Nos centres"
  description="Les cinq centres Hakili Lab à Ouagadougou : Pissy, Tampouy, Saaba, SIAO et Nagrin. Horaires, classes ouvertes et itinéraire pour chaque centre."
  breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'Nos centres' }]}
  jsonLd={itemListJsonLd}
  hideBreadcrumb
>
<section class="section">
  <div class="wrap">
    <a class="post-link" href="/">&larr; Accueil</a>
    <span class="eyebrow">Nos centres</span>
    <h1 class="h2">Cinq centres à Ouagadougou</h1>
    <p class="lead">Chaque centre accueille les élèves après les cours en semaine et le week-end.</p>
    <div class="centres">
      {centres.map((centre) => {
        const photo = centre.image && (
          <Picture
            src={centre.image}
            formats={['avif', 'webp']}
            widths={[400, 760]}
            sizes="(max-width: 680px) 100vw, (max-width: 1080px) 50vw, 380px"
            alt={`Centre de ${centre.nom}`}
            loading="lazy"
          />
        );
        return (
          <article class="centre">
            <div class="centre-photo">
              {photo}
              <b>{centre.nom}</b>
            </div>
            <div class="centre-body">
              <h2>{centre.nom}</h2>
              {centre.pretPourPublication && (
                <a class="centre-link" href={`/centres/${centre.slug}`}>Voir le centre de {centre.nom}</a>
              )}
            </div>
          </article>
        );
      })}
    </div>
    <div class="centres-cta">
      <a class="btn btn-primary" href="https://forms.gle/FMWP9KZtjrxyVT3x6" target="_blank" rel="noopener">Prendre rendez-vous dans un centre</a>
    </div>
  </div>
</section>
</SiteLayout>
