---
// Coquille commune a presque toutes les pages : TopBar + Header + <main> +
// fil d'Ariane optionnel + Footer + scripts globaux (nav, reveal au
// defilement...). Enveloppe BaseLayout.astro pour le <head>.
import BaseLayout from './BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DetailModal from '../components/DetailModal.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../lib/breadcrumbs.js';

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
  jsonLd?: object | object[];
  hideBreadcrumb?: boolean;
}

const { title, description, breadcrumbs, jsonLd, hideBreadcrumb } = Astro.props;

// hideBreadcrumb ne joue que sur l'affichage : le balisage JSON-LD
// BreadcrumbList reste emis sur toute page qui recoit un tableau breadcrumbs,
// meme quand le fil d'Ariane visuel est remplace par un lien de retour.
const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allJsonLd = breadcrumbs && breadcrumbs.length > 1
  ? [...extraJsonLd, breadcrumbJsonLd(breadcrumbs)]
  : extraJsonLd;
---
<BaseLayout title={title} description={description} jsonLd={allJsonLd}>
<TopBar />

<Header />

<main id="contenu">
  {breadcrumbs && breadcrumbs.length > 1 && !hideBreadcrumb && <Breadcrumbs items={breadcrumbs} />}
  <slot />
</main>

<Footer />

<DetailModal />

<script>
  import '../scripts/nav.js';
  import '../scripts/nav-active.js';
  import '../scripts/detail-modal.js';
  import '../scripts/scroll-reveal.js';
</script>
</BaseLayout>
