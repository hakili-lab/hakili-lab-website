---
// Page /contact : page d'affichage des coordonnees generales du centre
// (telephone, e-mail, WhatsApp). Aucun formulaire, aucun service tiers - les
// valeurs viennent toutes de src/data/site.js. Pour les coordonnees d'un
// centre precis, la page renvoie vers /centres.
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE_URL, SITE_PHONES, SITE_EMAIL, WHATSAPP_NUMBER } from '../../data/site.js';

const whatsappMessage = 'Bonjour Hakili Lab, je souhaite des informations.';
const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(whatsappMessage)}`;

const contactPointJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'Hakili Lab',
  url: SITE_URL,
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: SITE_PHONES.map((p) => p.tel),
    email: SITE_EMAIL,
    contactType: 'customer service',
    areaServed: 'BF',
    availableLanguage: 'French',
  },
};
---
<SiteLayout
  title="Contact"
  description={`Appelez-nous au ${SITE_PHONES.map((p) => p.display).join(' ou ')}, écrivez à ${SITE_EMAIL} ou passez par WhatsApp. Cinq centres à Ouagadougou : Pissy, Tampouy, Saaba, SIAO, Nagrin.`}
  breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'Contact' }]}
  jsonLd={contactPointJsonLd}
  hideBreadcrumb
>
<section class="section contact">
  <div class="wrap" style="max-width:640px">
    <a class="post-link" href="/">&larr; Accueil</a>
    <span class="eyebrow eyebrow-light">Contact</span>
    <h1 class="h2">Contactez-nous</h1>
    <p class="contact-lead">Écrivez-nous ou appelez-nous. Nous vous proposons un test de positionnement gratuit avant toute inscription.</p>
    <ul class="contact-items">
      <li>
        <span class="icon"><svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg></span>
        <div>
          <b>{SITE_PHONES.map((p, i) => (<>{i > 0 && ' / '}<a href={`tel:${p.tel}`}>{p.display}</a></>))}</b>
          <span>Du lundi au samedi, 8h à 18h</span>
        </div>
      </li>
      <li>
        <span class="icon"><svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg></span>
        <div>
          <b><a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a></b>
          <span>Pour toute demande écrite</span>
        </div>
      </li>
      <li>
        <span class="icon"><svg viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
        <div>
          <b>Cinq centres à Ouagadougou</b>
          <span>Pissy, Tampouy, Saaba, SIAO, Nagrin. Pour l’adresse et les horaires d’un centre précis, voir <a href="/centres">la page des centres</a>.</span>
        </div>
      </li>
    </ul>
    <div class="hero-actions" style="margin-top:34px">
      <a class="btn btn-green" href={whatsappUrl} target="_blank" rel="noopener">Nous écrire sur WhatsApp</a>
      <a class="btn btn-ghost" href="/centres">Coordonnées d’un centre</a>
    </div>
  </div>
</section>
</SiteLayout>
