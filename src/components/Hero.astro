---
// Bandeau plein cadre de l'accueil : diaporama photo en fondu (voir
// src/scripts/hero-slideshow.js pour le minutage) derrière le titre et les
// CTA principaux du site.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import heroImg1 from '../assets/photos/37.jpeg';
import heroImg2 from '../assets/photos/36.jpeg';
import heroImg3 from '../assets/photos/40.jpeg';

const heroImages: { src: ImageMetadata; focus?: string }[] = [
  { src: heroImg1 },
  { src: heroImg2 },
  { src: heroImg3 }, // ex: { src: heroImg3, focus: 'center 20%' } pour recadrer une image
];
const DEFAULT_FOCUS = 'center 35%';
---
<section class="hero" id="accueil">
  <div class="hero-media" aria-hidden="true">
    <Picture
      src={heroImages[0].src}
      formats={['avif', 'webp']}
      widths={[800, 1400, 2000, 2600]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      class="is-active"
      style={`object-position:${heroImages[0].focus || DEFAULT_FOCUS}`}
    />
    {heroImages.slice(1).map((img) => (
      <template data-hero-slide>
        <Picture
          src={img.src}
          formats={['avif', 'webp']}
          widths={[800, 1400, 2000, 2600]}
          sizes="100vw"
          alt=""
          loading="lazy"
          style={`object-position:${img.focus || DEFAULT_FOCUS}`}
        />
      </template>
    ))}
  </div>
  <div class="wrap">
    <span class="claim">CENTRE D’EXCELLENCE EN MATHEMATIQUES</span>
    <h1>Votre enfant peut <em>vraiment</em> comprendre les maths.</h1>
    <p class="hero-lead">Tutorat en mathématiques et en physique-chimie, du primaire au secondaire. Des groupes de niveau, des enseignants formés, et un suivi qui part des lacunes réelles de chaque élève.</p>
    <div class="hero-actions">
      <a class="btn btn-green" href="https://forms.gle/FMWP9KZtjrxyVT3x6" target="_blank" rel="noopener">Inscrire mon enfant</a>
      <a class="btn btn-ghost" href="/methode">Découvrir notre méthode</a>
    </div>
    <p class="hero-meta">Ouagadougou &nbsp;•&nbsp; Cinq centres &nbsp;•&nbsp; Depuis 2020</p>
  </div>
</section>
