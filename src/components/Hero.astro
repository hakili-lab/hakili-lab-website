---
// Bandeau plein cadre de l'accueil : diaporama photo en fondu (voir
// src/scripts/hero-slideshow.js pour le minutage) derrière le titre et les
// CTA principaux du site.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import heroImg1 from '../assets/photos/37.jpeg';
import heroImg2 from '../assets/photos/36.jpeg';
import heroImg3 from '../assets/photos/40.jpeg';
import { hero } from '../data/hero.js';

const heroImages: { src: ImageMetadata; focus?: string }[] = [
  { src: heroImg1 },
  { src: heroImg2 },
  { src: heroImg3 }, // ex: { src: heroImg3, focus: 'center 20%' } pour recadrer une image
];
const DEFAULT_FOCUS = 'center 35%';
---
<section class="hero" id="accueil">
  <div class="hero-media" aria-hidden="true">
    <Picture
      src={heroImages[0].src}
      formats={['avif', 'webp']}
      widths={[800, 1400, 2000, 2600]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      class="is-active"
      style={`object-position:${heroImages[0].focus || DEFAULT_FOCUS}`}
    />
    {heroImages.slice(1).map((img) => (
      <template data-hero-slide>
        <Picture
          src={img.src}
          formats={['avif', 'webp']}
          widths={[800, 1400, 2000, 2600]}
          sizes="100vw"
          alt=""
          loading="lazy"
          style={`object-position:${img.focus || DEFAULT_FOCUS}`}
        />
      </template>
    ))}
  </div>
  <div class="wrap">
    <span class="claim">CENTRE D’EXCELLENCE EN MATHEMATIQUES</span>
    <h1>{hero.titre.avant}<em>{hero.titre.accent}</em>{hero.titre.apres}</h1>
    <p class="hero-lead">{hero.sousTitre}</p>
    <div class="hero-actions">
      <a class="btn btn-green" href={hero.boutons[0].lien} target={hero.boutons[0].lien.startsWith('http') ? '_blank' : undefined} rel={hero.boutons[0].lien.startsWith('http') ? 'noopener' : undefined}>{hero.boutons[0].texte}</a>
      <a class="btn btn-ghost" href={hero.boutons[1].lien} target={hero.boutons[1].lien.startsWith('http') ? '_blank' : undefined} rel={hero.boutons[1].lien.startsWith('http') ? 'noopener' : undefined}>{hero.boutons[1].texte}</a>
    </div>
    <p class="hero-meta">{hero.meta.map((m, i) => (<Fragment>{i > 0 && <Fragment> &nbsp;•&nbsp; </Fragment>}{m}</Fragment>))}</p>
  </div>
</section>
