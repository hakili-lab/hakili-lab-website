---
// Page d'erreur 404 : message court + raccourcis vers les pages les plus
// utiles. Exclue du sitemap (voir astro.config.mjs).
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page introuvable" description="Cette page n'existe pas ou plus. Retrouvez l'accueil, nos centres, nos services ou le formulaire d'inscription de Hakili Lab.">
<section class="section">
  <div class="wrap" style="text-align:center;max-width:640px">
    <span class="eyebrow" style="justify-content:center">Erreur 404</span>
    <h1 class="h2">Cette page n'existe pas</h1>
    <p class="lead" style="margin-left:auto;margin-right:auto">Le lien que vous avez suivi est peut-être ancien ou mal orthographié. Voici les pages les plus utiles :</p>
    <div class="hero-actions" style="justify-content:center;margin-top:28px">
      <a class="btn btn-primary" href="/">Retour à l'accueil</a>
      <a class="btn btn-outline" href="/centres">Nos centres</a>
      <a class="btn btn-outline" href="https://forms.gle/FMWP9KZtjrxyVT3x6" target="_blank" rel="noopener">Inscription</a>
      <a class="btn btn-outline" href="/contact">Contact</a>
    </div>
  </div>
</section>
</SiteLayout>
