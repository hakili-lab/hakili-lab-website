---
// Page FAQ : liste plate de questions/reponses, avec balisage JSON-LD FAQPage
// correspondant pour les moteurs de recherche.
//
// Textes editables depuis /admin : src/data/faq.json (schema et validation
// dans src/data/faq.js). Le balisage JSON-LD est construit a partir des memes
// donnees, il ne peut donc pas diverger de ce qui est affiche.
//
// La premiere question est ouverte par defaut, les suivantes fermees : c'est
// une regle d'affichage, pas une donnee editable.
import SiteLayout from '../../layouts/SiteLayout.astro';
import { faq } from '../../data/faq.js';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.questions.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: q.reponse },
  })),
};
---
<SiteLayout
  title="Questions fréquentes"
  description="Comment se passe l'inscription à Hakili Lab ? Prise de contact, test de positionnement gratuit, proposition d'un groupe et d'un horaire, puis inscription."
  breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'FAQ' }]}
  jsonLd={faqJsonLd}
  hideBreadcrumb
>
<section class="section">
  <div class="wrap">
    <a class="post-link" href="/">&larr; Accueil</a>
    <span class="eyebrow">{faq.eyebrow}</span>
    <h1 class="h2">{faq.titre}</h1>
    <p class="lead">{faq.intro}</p>
    <div class="faq">
      {faq.questions.map((q, i) => (
        <details open={i === 0}><summary>{q.question}</summary><div class="answer">{q.reponse}</div></details>
      ))}
    </div>
    <div class="hero-actions" style="margin-top:30px">
      <a class="btn btn-outline" href="/contact">{faq.cta}</a>
    </div>
  </div>
</section>
</SiteLayout>
