---
// Page /a-propos : histoire et fondateurs (PersonCard, donnees dans
// src/data/team.js) de Hakili Lab. Les valeurs et les engagements des eleves
// vivent desormais sur /valeurs ; il n'en reste ici qu'un teaser. L'ancre
// #valeurs est conservee sur ce teaser pour les liens externes deja partages.
import SiteLayout from '../../layouts/SiteLayout.astro';
import PersonCard from '../../components/PersonCard.astro';
import { fondateurs } from '../../data/team.js';

// Video de presentation. Seul endroit ou l'identifiant YouTube est ecrit : la
// vignette et l'iframe de la fenetre modale en decoulent tous les deux, donc
// changer de video tient en une ligne. La legende voyage avec, elle sert de
// titre a la fenetre modale (aria-labelledby="modalTitle").
const VIDEO_ID = 'J304iUf3VvY';
const VIDEO_TITRE = 'Une journée dans un centre Hakili Lab';
---
<SiteLayout
  title="Qui sommes-nous"
  description="L'échec en mathématiques n'est presque jamais une question de capacité. À Hakili Lab, nous commençons par un test de positionnement, puis nous reprenons ce qui manque, dans l'ordre."
  breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'À propos' }]}
  hideBreadcrumb
>
<section class="section">
  <div class="wrap split">
    <div class="about">
      <a class="post-link" href="/">&larr; Accueil</a>
      <span class="eyebrow">Qui sommes-nous</span>
      <h1 class="since">Depuis 2020</h1>
      <p class="lead">L’échec en mathématiques n’est presque jamais une question de capacité. C’est le plus souvent une accumulation de lacunes que personne n’a eu le temps de reprendre : un élève de 3<sup>e</sup> qui bloque sur les équations bute en réalité sur une notion vue deux ou trois ans plus tôt.</p>
      <p class="lead">À Hakili Lab, nous commençons donc par un test de positionnement, puis nous reprenons ce qui manque, dans l’ordre. C’est plus lent au début et beaucoup plus rapide ensuite.</p>
      <ul class="marks">
        <li><span class="tick"><svg viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"/></svg></span><div>Des enseignants formés aux méthodes d’enseignement des mathématiques des systèmes éducatifs les plus performants</div></li>
        <li><span class="tick"><svg viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"/></svg></span><div>Une communauté d’apprentissage où la question de l’élève a autant de valeur que la réponse de l’enseignant</div></li>
        <li><span class="tick"><svg viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"/></svg></span><div>Nos propres manuels, écrits pour le programme burkinabè et testés dans nos classes</div></li>
      </ul>
      <div class="hero-actions" style="margin-top:28px">
        <a class="btn btn-primary" href="/methode">Découvrir notre méthode</a>
        <a class="btn btn-outline" href="/enseignants">Nos enseignants</a>
      </div>
    </div>
    <button
      class="video-wrap"
      type="button"
      data-video-id={VIDEO_ID}
      data-video-titre={VIDEO_TITRE}
      aria-label="Voir la vidéo de présentation"
    >
      <img src={`https://img.youtube.com/vi/${VIDEO_ID}/hqdefault.jpg`} width="480" height="360" alt="Une séance de cours dans un centre Hakili Lab" loading="lazy" />
      <span class="play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
      <span class="video-cap">{VIDEO_TITRE} &nbsp;•&nbsp; 2 min</span>
    </button>
  </div>
</section>

<section class="section section-cloud" id="valeurs">
  <div class="wrap" style="max-width:760px">
    <span class="eyebrow">Nos valeurs</span>
    <h2 class="h2">Ce qui nous anime</h2>
    <p class="lead">Six convictions guident notre travail au quotidien, et quatre engagements accompagnent chaque élève qui rejoint nos centres.</p>
    <div class="hero-actions" style="margin-top:28px">
      <a class="btn btn-outline" href="/valeurs">Découvrir nos valeurs &rarr;</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <span class="eyebrow">Hakili Lab</span>
    <h2 class="h2">Nos fondateurs</h2>
    <div class="person-grid">
      {fondateurs.map((p) => <PersonCard name={p.name} role={p.role} bio={p.bio} photo={p.photo} />)}
    </div>
  </div>
</section>
</SiteLayout>
