---
import { Picture } from 'astro:assets';
import photoA from '../assets/photos/846A26820.jpg';
import photoB from '../assets/photos/846A2755.jpg';
import photoC from '../assets/photos/banner1.jpg';
import { SITE_URL } from '../data/site.js';

const centrePhotoSizes = '(max-width: 680px) 100vw, (max-width: 1080px) 50vw, 380px';

const centres = ['Pissy', 'Tampouy', 'Saaba', 'SIAO', 'Nagrin'];
const centresJsonLd = centres.map((nom) => ({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: `Hakili Lab — ${nom}`,
  parentOrganization: 'Hakili Lab',
  email: 'info@hakililab.com',
  telephone: ['+22657919191', '+22658795050'],
  openingHours: 'Mo-Sa 08:00-18:00',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ouagadougou',
    addressCountry: 'BF',
    // TODO(url): streetAddress et postalCode du centre de ${nom}
  },
  // TODO(url): coordonnees GPS (geo.latitude / geo.longitude) du centre de ${nom}
  ...(SITE_URL ? { url: SITE_URL + '#centres' } : {}),
}));
---
<section class="section" id="centres">
  <div class="wrap">
    <span class="eyebrow">Nos centres</span>
    <h2 class="h2">Cinq centres à Ouagadougou</h2>
    <p class="lead">Chaque centre accueille les élèves après les cours en semaine et le week-end.</p>
    <div class="centres">
      <article class="centre">
        <div class="centre-photo"><Picture src={photoA} formats={['avif', 'webp']} widths={[400, 760]} sizes={centrePhotoSizes} alt="Centre de Pissy" loading="lazy" /><b>Pissy</b></div>
        <div class="centre-body"><h3>Pissy</h3><p>Notre centre historique, au coeur d'un quartier dense, avec l'offre la plus complète : primaire et secondaire, du CP1 à la Terminale.</p><!-- TODO(url): lien Google Maps du centre de Pissy --><a class="centre-link" href="#contact">Nous rendre visite</a></div>
      </article>
      <article class="centre">
        <div class="centre-photo"><Picture src={photoB} formats={['avif', 'webp']} widths={[400, 760]} sizes={centrePhotoSizes} alt="Centre de Tampouy" loading="lazy" /><b>Tampouy</b></div>
        <div class="centre-body"><h3>Tampouy</h3><p>Un centre facilement accessible depuis le nord de la ville, avec des séances en fin d'après-midi et le samedi.</p><!-- TODO(url): lien Google Maps du centre de Tampouy --><a class="centre-link" href="#contact">Nous rendre visite</a></div>
      </article>
      <article class="centre">
        <div class="centre-photo"><Picture src={photoC} formats={['avif', 'webp']} widths={[400, 760]} sizes={centrePhotoSizes} alt="Centre de Saaba" loading="lazy" /><b>Saaba</b></div>
        <div class="centre-body"><h3>Saaba</h3><p>À l'est de Ouagadougou, un cadre calme qui accueille surtout les élèves du primaire et du premier cycle du secondaire.</p><!-- TODO(url): lien Google Maps du centre de Saaba --><a class="centre-link" href="#contact">Nous rendre visite</a></div>
      </article>
      <article class="centre">
        <div class="centre-photo"><Picture src={photoB} formats={['avif', 'webp']} widths={[400, 760]} sizes={centrePhotoSizes} alt="Centre du SIAO" loading="lazy" /><b>SIAO</b></div>
        <div class="centre-body"><h3>SIAO</h3><p>Un centre central, pratique pour les familles qui viennent chercher leurs enfants en sortant du travail.</p><!-- TODO(url): lien Google Maps du centre du SIAO --><a class="centre-link" href="#contact">Nous rendre visite</a></div>
      </article>
      <article class="centre">
        <div class="centre-photo"><Picture src={photoA} formats={['avif', 'webp']} widths={[400, 760]} sizes={centrePhotoSizes} alt="Centre de Nagrin" loading="lazy" /><b>Nagrin</b></div>
        <div class="centre-body"><h3>Nagrin</h3><p>Notre implantation la plus récente, au sud de la ville, avec des groupes à taille réduite.</p><!-- TODO(url): lien Google Maps du centre de Nagrin --><a class="centre-link" href="#contact">Nous rendre visite</a></div>
      </article>
    </div>
    <div class="centres-cta">
      <a class="btn btn-primary" href="#contact">Prendre rendez-vous dans un centre</a>
    </div>
  </div>
</section>
<!-- TODO(url): adresse postale et coordonnees GPS de chaque centre, a completer ci-dessous une fois connues -->
{centresJsonLd.map((json) => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(json)} />
))}
