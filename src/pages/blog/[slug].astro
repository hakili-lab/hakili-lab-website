---
// Page d'un article de blog (une route par entree publiee, brouillon:false).
//
// Une zone de commentaires Giscus est preparee en bas de page, entierement
// commentee donc sans effet pour le visiteur. Voir docs/COMMENTAIRES.md.
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.brouillon);
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateFormatter = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const plainDescription = post.data.description.replace(/<[^>]+>/g, '');
---
<SiteLayout
  title={`${post.data.titre}, Hakili Lab`}
  description={plainDescription}
  breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'Blog', href: '/blog' }, { label: post.data.titre }]}
>
<article class="section">
  <div class="wrap article">
    <span class="eyebrow">{post.data.categorie}</span>
    <h1 class="h2">{post.data.titre}</h1>
    <p class="lead">{dateFormatter.format(post.data.date)}</p>
    {post.data.image && (
      <Picture
        src={post.data.image}
        formats={['avif', 'webp']}
        widths={[500, 900, 1200]}
        sizes="(min-width: 780px) 780px, 100vw"
        alt=""
        class="article-image"
      />
    )}
    <div class="article-body">
      <Content />
    </div>
  </div>
</article>

{/* Zone reservee aux commentaires (Giscus), pas encore activee.

    Tout le bloc ci-dessous est commente : a ce stade rien n'est rendu, rien
    n'est charge, et un visiteur ne voit aucune difference. Il n'y a pas de
    section vide ni de titre orphelin dans la page.

    Pour activer, en une seule fois (procedure detaillee : docs/COMMENTAIRES.md) :
      1. remplacer les trois valeurs A_VOIR_SUR_GISCUS_APP par celles que
         giscus.app fournit pour ce depot ;
      2. retirer la ligne d'ouverture de ce commentaire et sa ligne de
         fermeture, plus bas.
    Ne decommentez pas avant d'avoir les vraies valeurs : le script se
    chargerait sans pouvoir se rattacher a une discussion.

