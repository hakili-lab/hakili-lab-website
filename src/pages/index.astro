---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import LevelFinder from '../components/LevelFinder.astro';
import Method from '../components/Method.astro';
import Brochure from '../components/Brochure.astro';
import Footer from '../components/Footer.astro';
import DetailModal from '../components/DetailModal.astro';
import quotePhoto from '../assets/photos/846A2755.jpg';

const serviceOrder = ['cours-appui', 'remediation', 'camp-vacances', 'preparation-examens'];
const services = (await getCollection('services', ({ data }) => data.pretPourPublication)).sort(
  (a, b) => serviceOrder.indexOf(a.data.slug) - serviceOrder.indexOf(b.data.slug)
);

const centreOrder = ['pissy', 'tampouy', 'saaba'];
const allCentres = await getCollection('centres', ({ data }) => data.pretPourPublication);
const centres = allCentres
  .filter((c) => centreOrder.includes(c.data.slug))
  .sort((a, b) => centreOrder.indexOf(a.data.slug) - centreOrder.indexOf(b.data.slug));

const faqQuestion = 'Comment se passe l’inscription ?';
const faqReponse = 'Prise de contact, test de positionnement gratuit, proposition d’un groupe et d’un horaire, puis inscription.';
---
<BaseLayout>
<TopBar />

<Header />

<main id="contenu">
<Hero />

<LevelFinder />

<Method />

<section class="section-breather-stat">
  <div class="wrap">
    <span class="breather-num">79+</span>
    <p>enseignants formés aux méthodes modernes, dans nos cinq centres à Ouagadougou.</p>
  </div>
</section>

<section class="section" id="services">
  <div class="wrap">
    <span class="eyebrow">Services</span>
    <h2 class="h2">Nos formules d’accompagnement</h2>
    <p class="lead">La matière ne suffit pas : le format compte autant. Diagnostiquer avant d’enseigner, enseigner en petits groupes, mesurer les progrès.</p>
    <div class="cards-3" style="margin-top:32px">
      {services.map((service) => (
        <a class="card" href={`/services/${service.data.slug}`}>
          <h3>{service.data.nom}</h3>
          <p>{service.data.resumeCourt}</p>
          <span class="card-more" style="pointer-events:none">En savoir plus &rarr;</span>
        </a>
      ))}
    </div>
    <div class="hero-actions" style="margin-top:28px">
      <a class="btn btn-outline" href="/services">Voir tous nos services &rarr;</a>
    </div>
  </div>
</section>

<section class="section section-cloud" id="centres">
  <div class="wrap">
    <span class="eyebrow">Nos centres</span>
    <h2 class="h2">Cinq centres à Ouagadougou</h2>
    <p class="lead">Chaque centre accueille les élèves après les cours en semaine et le week-end.</p>
    <div class="centres" style="grid-template-columns:repeat(3,1fr)">
      {centres.map((centre) => (
        <article class="centre">
          <div class="centre-photo">
            {centre.data.image && (
              <Picture
                src={centre.data.image}
                formats={['avif', 'webp']}
                widths={[400, 760]}
                sizes="(max-width: 680px) 100vw, (max-width: 1080px) 50vw, 380px"
                alt={`Centre de ${centre.data.nom}`}
                loading="lazy"
              />
            )}
            <b>{centre.data.nom}</b>
          </div>
          <div class="centre-body">
            <h3>{centre.data.nom}</h3>
            <p>{centre.data.resume}</p>
            <a class="centre-link" href={`/centres/${centre.data.slug}`}>Voir le centre de {centre.data.nom}</a>
          </div>
        </article>
      ))}
    </div>
    <div class="centres-cta">
      <a class="btn btn-primary" href="/centres">Voir les cinq centres &rarr;</a>
    </div>
  </div>
</section>

<section class="breather-quote">
  <Picture
    src={quotePhoto}
    formats={['avif', 'webp']}
    widths={[800, 1400, 2000]}
    sizes="100vw"
    alt=""
    loading="lazy"
    class="breather-quote-img"
  />
  <blockquote>« L’échec en mathématiques n’est presque jamais une question de talent. »</blockquote>
</section>

<Brochure />

<section class="section" id="faq">
  <div class="wrap">
    <span class="eyebrow">Questions fréquentes</span>
    <h2 class="h2 is-minor">Ce que les parents nous demandent</h2>
    <div class="faq">
      <details open><summary>{faqQuestion}</summary><div class="answer">{faqReponse}</div></details>
    </div>
    <div class="hero-actions" style="margin-top:20px">
      <a class="btn btn-outline" href="/faq">Toutes les questions &rarr;</a>
    </div>
  </div>
</section>

<section class="section contact" id="contact">
  <div class="wrap" style="max-width:560px;text-align:center">
    <span class="eyebrow eyebrow-light" style="justify-content:center">Contact</span>
    <h2 class="h2">Inscrivez votre enfant</h2>
    <p class="contact-lead" style="margin-left:auto;margin-right:auto">Écrivez-nous ou appelez-nous. Nous vous proposons un test de positionnement gratuit avant toute inscription.</p>
    <div class="hero-actions" style="margin-top:26px;justify-content:center">
      <a class="btn btn-green" href="/inscription">Inscrire mon enfant</a>
      <a class="btn btn-ghost" href="/contact">Nos coordonnées</a>
    </div>
  </div>
</section>
</main>

<Footer />

<DetailModal />

<script>
  import '../scripts/legacy-anchors.js';
  import '../scripts/nav.js';
  import '../scripts/level-finder.js';
  import '../scripts/detail-modal.js';
  import '../scripts/hero-slideshow.js';
  import '../scripts/scroll-reveal.js';
</script>
</BaseLayout>
