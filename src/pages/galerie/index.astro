---
import { Picture } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import photoA from '../../assets/photos/846A26820.jpg';
import photoB from '../../assets/photos/846A2755.jpg';
import photoC from '../../assets/photos/banner1.jpg';

const gallerySizes = '(max-width: 680px) 50vw, (max-width: 1080px) 33vw, 400px';
---
<SiteLayout
  title="Galerie — la vie dans nos centres — Hakili Lab"
  description="La vie dans les centres Hakili Lab : élèves en séance de travail, enseignants au tableau, remise des prix du concours de mathématiques."
  breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'Galerie' }]}
>
<section class="section">
  <div class="wrap">
    <span class="eyebrow">Galerie</span>
    <h1 class="h2">La vie dans nos centres</h1>
    <div class="gallery">
      <figure><Picture src={photoA} formats={['avif', 'webp']} widths={[300, 600, 900]} sizes={gallerySizes} alt="Élèves en séance de travail" loading="lazy" /></figure>
      <figure><Picture src={photoB} formats={['avif', 'webp']} widths={[300, 600, 900]} sizes={gallerySizes} alt="Enseignant au tableau" loading="lazy" /></figure>
      <figure><Picture src={photoC} formats={['avif', 'webp']} widths={[300, 600, 900]} sizes={gallerySizes} alt="Vue d’un centre Hakili Lab" loading="lazy" /></figure>
      <figure><Picture src={photoB} formats={['avif', 'webp']} widths={[300, 600, 900]} sizes={gallerySizes} alt="Travail en petit groupe" loading="lazy" /></figure>
      <figure><Picture src={photoA} formats={['avif', 'webp']} widths={[300, 600, 900]} sizes={gallerySizes} alt="Remise des prix du concours de mathématiques" loading="lazy" /></figure>
    </div>
  </div>
</section>
</SiteLayout>
