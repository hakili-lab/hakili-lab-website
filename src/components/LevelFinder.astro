---
// Selecteur "cycle puis classe" de l'accueil : affiche la description du
// niveau choisi. Coquille HTML seulement, la logique d'onglets est dans
// src/scripts/level-finder.js (donnees dans src/data/levels.js).
---
<div class="finder">
  <div class="wrap">
    <div class="finder-card">
      <h2 class="finder-title">Où en est votre enfant ?</h2>
      <p class="finder-sub">Choisissez son cycle, puis sa classe.</p>

      <div class="cycles" id="cycles" role="tablist" aria-label="Cycle scolaire">
        <button class="cycle is-active" data-c="prim" role="tab" id="tab-cycle-prim" aria-selected="true" aria-controls="panel-prim" tabindex="0">Primaire</button>
        <button class="cycle" data-c="sec" role="tab" id="tab-cycle-sec" aria-selected="false" aria-controls="panel-sec" tabindex="-1">Secondaire</button>
      </div>

      <div class="classes-panel" id="panel-prim" role="tabpanel" aria-labelledby="tab-cycle-prim">
        <div class="classes" data-c="prim" role="tablist" aria-label="Classe du primaire">
          <button class="klass is-active" data-k="cp1" role="tab" id="tab-klass-cp1" aria-selected="true" aria-controls="level-panel" tabindex="0">CP1</button>
          <button class="klass" data-k="cp2" role="tab" id="tab-klass-cp2" aria-selected="false" aria-controls="level-panel" tabindex="-1">CP2</button>
          <button class="klass" data-k="ce1" role="tab" id="tab-klass-ce1" aria-selected="false" aria-controls="level-panel" tabindex="-1">CE1</button>
          <button class="klass" data-k="ce2" role="tab" id="tab-klass-ce2" aria-selected="false" aria-controls="level-panel" tabindex="-1">CE2</button>
          <button class="klass" data-k="cm1" role="tab" id="tab-klass-cm1" aria-selected="false" aria-controls="level-panel" tabindex="-1">CM1</button>
          <button class="klass" data-k="cm2" role="tab" id="tab-klass-cm2" aria-selected="false" aria-controls="level-panel" tabindex="-1">CM2</button>
        </div>
      </div>
      <div class="classes-panel" id="panel-sec" role="tabpanel" aria-labelledby="tab-cycle-sec" hidden>
        <div class="classes" data-c="sec" role="tablist" aria-label="Classe du secondaire">
          <button class="klass is-active" data-k="s6" role="tab" id="tab-klass-s6" aria-selected="true" aria-controls="level-panel" tabindex="0">6<sup>e</sup></button>
          <button class="klass" data-k="s5" role="tab" id="tab-klass-s5" aria-selected="false" aria-controls="level-panel" tabindex="-1">5<sup>e</sup></button>
          <button class="klass" data-k="s4" role="tab" id="tab-klass-s4" aria-selected="false" aria-controls="level-panel" tabindex="-1">4<sup>e</sup></button>
          <button class="klass" data-k="s3" role="tab" id="tab-klass-s3" aria-selected="false" aria-controls="level-panel" tabindex="-1">3<sup>e</sup></button>
          <button class="klass" data-k="s2" role="tab" id="tab-klass-s2" aria-selected="false" aria-controls="level-panel" tabindex="-1">2<sup>nde</sup></button>
          <button class="klass" data-k="s1" role="tab" id="tab-klass-s1" aria-selected="false" aria-controls="level-panel" tabindex="-1">1<sup>re</sup></button>
          <button class="klass" data-k="st" role="tab" id="tab-klass-st" aria-selected="false" aria-controls="level-panel" tabindex="-1">Terminale</button>
        </div>
      </div>

      <div class="level-panel" id="level-panel" role="tabpanel" aria-labelledby="tab-klass-cp1">
        <div>
          <h3 id="lvTitle">CP1</h3>
          <p id="lvDesc">Premiers apprentissages du nombre et du calcul, dans un cadre rassurant et très progressif.</p>
        </div>
        <div class="level-fact"><span>Matières</span><b id="lvMat">Mathématiques</b></div>
        <div class="level-fact"><span>Objectif</span><b id="lvObj">Bases du nombre</b></div>
        <a class="btn btn-primary btn-sm" href="/horaires.pdf" target="_blank" rel="noopener">Voir les horaires</a>
      </div>
    </div>

    <div class="stats">
      <div class="stat"><b>5</b><span>centres à Ouagadougou</span></div>
      <div class="stat"><b>79+</b><span>enseignants formés aux méthodes modernes</span></div>
      <div class="stat"><b>3</b><span>matières : maths, physique-chimie et SVT</span></div>
      <div class="stat"><b>2020</b><span>année de création de Hakili Lab</span></div>
    </div>
  </div>
</div>
