---
// Coquille HTML de la fiche détail modale (services, manuels, applications).
// Vide au chargement : src/scripts/detail-modal.js la remplit et l'ouvre au
// clic sur une carte, en piochant dans src/data/details.js.
---
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-panel">
    <button class="modal-close" id="modalClose" aria-label="Fermer">&times;</button>
    <div id="modalBody"></div>
  </div>
</div>
