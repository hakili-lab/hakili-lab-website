---
import logo from '../assets/logo-hakili-lab.png';
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="#accueil">
      <img src={logo.src} alt="Hakili Lab">
      <span class="brand-line">CENTRE D'EXCELLENCE<em>EN MATHEMATIQUES</em></span>
    </a>
    <button class="nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false" id="navToggle"><span></span><span></span><span></span></button>
    <nav class="mainnav" id="nav">
      <div class="navitem"><a href="#accueil">Accueil</a></div>
      <div class="navitem">
        <a href="#apropos">A propos <i class="caret"></i></a>
        <div class="submenu">
          <div class="submenu-head">Hakili Lab</div>
          <a href="#apropos">Qui sommes-nous<small>Notre raison d'être, depuis 2020</small></a>
          <a href="#methode">Notre méthode<small>Diagnostiquer avant d'enseigner</small></a>
          <a href="#enseignants">Nos enseignants<small>Recrutement et formation continue</small></a>
          <a href="#centres">Nos centres<small>Cinq adresses à Ouagadougou</small></a>
        </div>
      </div>
      <div class="navitem">
        <a href="#services">Services <i class="caret"></i></a>
        <div class="submenu">
          <div class="submenu-head">Par cycle</div>
          <a href="#services">Primaire<small>CP1, CP2, CE1, CE2, CM1, CM2</small></a>
          <a href="#services">Secondaire<small>6<sup>e</sup>, 5<sup>e</sup>, 4<sup>e</sup>, 3<sup>e</sup>, 2<sup>nde</sup>, 1<sup>re</sup>, Terminale</small></a>
          <div class="submenu-head">Matières</div>
          <a href="#services">Mathématiques<small>Du CP1 à la Terminale</small></a>
          <a href="#services">Physique-chimie<small>Au secondaire</small></a>
          <a href="#services">Anglais<small>6<sup>e</sup> et 5<sup>e</sup></small></a>
          <div class="submenu-head">Formules</div>
          <a href="#services">Cours d'appui<small>Suivre le programme de la classe</small></a>
          <a href="#services">Cours de remédiation<small>Combler les lacunes anciennes</small></a>
          <a href="#services">Camp Vacances<small>Programme intensif des congés</small></a>
          <a href="#services">Préparation aux examens<small>CEP, BEPC, baccalauréat</small></a>
        </div>
      </div>
      <div class="navitem">
        <a href="#productions">Nos Productions <i class="caret"></i></a>
        <div class="submenu">
          <div class="submenu-head">Collection Hakili Lab</div>
          <a href="#productions">Manuels de mathématiques<small>Du primaire à la Terminale</small></a>
          <a href="#productions">Extraits à feuilleter<small>Un chapitre de chaque niveau</small></a>
          <a href="#contact">Commande pour établissements<small>Tarifs dégressifs</small></a>
          <div class="submenu-head">Applications</div>
          <a href="#productions">Amira<small>Le professeur de maths 24 h sur 24</small></a>
          <a href="#productions">Diagnostic et remédiation<small>Situer l'élève et combler ses lacunes</small></a>
        </div>
      </div>
      <div class="navitem"><a href="#galerie">Galerie</a></div>
      <div class="navitem"><a href="#blog">Blog</a></div>
      <div class="navitem"><a href="#contact">Contact</a></div>
      <a class="btn btn-green btn-sm nav-cta" href="#contact">Inscrire mon enfant</a>
    </nav>
  </div>
</header>
