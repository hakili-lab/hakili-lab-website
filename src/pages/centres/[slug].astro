---
// Fiche detail d'un centre (une route par centre marque pretPourPublication
// dans src/data/centres.js), avec balisage JSON-LD LocalBusiness quand les
// donnees reelles (adresse + GPS) sont disponibles.
import { Picture } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE_URL } from '../../data/site.js';
import { isPlaceholder } from '../../lib/placeholders.js';
import { centres } from '../../data/centres.js';

export function getStaticPaths() {
  return centres
    .filter((centre) => centre.pretPourPublication)
    .map((centre) => ({
      params: { slug: centre.slug },
      props: { centre },
    }));
}

const { centre } = Astro.props;
const d = centre;

const hasClassesOuvertes = !isPlaceholder(d.classesOuvertes);
const hasAdresse = !isPlaceholder(d.adresse);
const hasGeo = typeof d.latitude === 'number' && typeof d.longitude === 'number';

// Aucun balisage structure plutot qu'un balisage creux : LocalBusiness n'est
// emis que si l'adresse ET les coordonnees GPS sont reelles toutes les deux.
const localBusinessJsonLd =
  hasAdresse && hasGeo
    ? {
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: `Hakili Lab (${d.nom})`,
        parentOrganization: 'Hakili Lab',
        description: d.description,
        url: `${SITE_URL}/centres/${d.slug}`,
        email: 'info@hakililab.com',
        telephone: ['+22657919191', '+22658795050'],
        openingHours: 'Mo-Sa 08:00-18:00',
        address: {
          '@type': 'PostalAddress',
          streetAddress: d.adresse,
          addressLocality: 'Ouagadougou',
          addressCountry: 'BF',
        },
        geo: { '@type': 'GeoCoordinates', latitude: d.latitude, longitude: d.longitude },
      }
    : undefined;
---
<SiteLayout
  title={`Centre Hakili Lab de ${d.nom} : horaires et itinéraire`}
  description={d.description}
  breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'Nos centres', href: '/centres' }, { label: d.nom }]}
  jsonLd={localBusinessJsonLd}
>
<section class="section">
  <div class="wrap split">
    <div>
      <span class="eyebrow">Nos centres</span>
      <h1 class="since">{d.nom}</h1>
      <p class="lead">{d.description}</p>

      <div class="modal-facts" style="margin-top:28px">
        <div class="fact">
          <span>Horaires</span>
          <b>{d.horaires.resume}</b>
        </div>
        {hasClassesOuvertes && (
          <div class="fact">
            <span>Classes ouvertes</span>
            <b>{d.classesOuvertes}</b>
          </div>
        )}
        {hasAdresse && (
          <div class="fact">
            <span>Adresse</span>
            <b>{d.adresse}</b>
          </div>
        )}
      </div>

      {!hasAdresse && (
        <p class="steps-note" style="margin-top:20px">
          Pour l’adresse exacte et l’itinéraire, appelez-nous : <a href="tel:+22657919191" style="text-decoration:underline">57 91 91 91</a> / <a href="tel:+22658795050" style="text-decoration:underline">58 79 50 50</a>.
        </p>
      )}

      {d.googleMapsUrl && (
        <div class="hero-actions" style="margin-top:30px">
          <a class="btn btn-outline" href={d.googleMapsUrl} target="_blank" rel="noopener">Voir sur Google Maps</a>
        </div>
      )}
    </div>
    {d.image && (
      <Picture
        src={d.image}
        formats={['avif', 'webp']}
        widths={[500, 900]}
        sizes="(max-width: 980px) 100vw, 560px"
        alt={`Centre de ${d.nom}`}
        loading="lazy"
        style="border-radius:var(--r);width:100%;height:auto;aspect-ratio:4/3;object-fit:cover"
      />
    )}
  </div>
</section>
</SiteLayout>
