---
// Bandeau "Recevez la plaquette de la rentree" : lien Voir (nouvel onglet)
// et lien Telecharger vers le meme PDF statique, sans formulaire ni JS.
const plaquetteFile = '/plaquette-rentree.pdf';
---
<section class="section section-cloud">
  <div class="wrap">
    <div class="brochure">
      <div>
        <h2>Recevez la plaquette de la rentrée</h2>
        <p>Classes ouvertes par centre, horaires, tarifs et calendrier du Camp Vacances : tout est réuni dans un document de quatre pages.</p>
      </div>
      <div class="brochure-actions">
        <a class="btn btn-ghost brochure-view" href={plaquetteFile} target="_blank" rel="noopener">Voir</a>
        <a class="btn brochure-download" href={plaquetteFile} download>Télécharger</a>
      </div>
    </div>
  </div>
</section>
