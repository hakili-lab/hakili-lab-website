---
import SiteLayout from '../../layouts/SiteLayout.astro';
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---
<SiteLayout
  title="Inscrivez votre enfant"
  description="Écrivez-nous ou appelez-nous. Nous vous proposons un test de positionnement gratuit avant toute inscription, dans l'un de nos cinq centres à Ouagadougou."
  breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'Inscription' }]}
  hideBreadcrumb
>
<section class="section contact">
  <div class="wrap">
    <a class="post-link" href="/">&larr; Accueil</a>
    <span class="eyebrow eyebrow-light">Inscription</span>
    <h1 class="h2">Inscrivez votre enfant</h1>
    <p class="contact-lead">Avant de vous inscrire, un test de positionnement gratuit nous permet de proposer le bon groupe et le bon horaire à votre enfant.</p>

    <form class="form" id="contactForm" novalidate style="margin-top:34px;max-width:640px">
      <div class="form-row">
        <label class="field"><span>Nom et prénom du parent</span><input type="text" name="nom" placeholder="Votre nom"></label>
        <label class="field"><span>Téléphone</span><input type="tel" name="telephone" placeholder="70 00 00 00"></label>
      </div>
      <div class="form-row">
        <label class="field"><span>Classe de l’enfant</span>
          <select name="classe">
            <optgroup label="Primaire"><option>CP1</option><option>CP2</option><option>CE1</option><option>CE2</option><option>CM1</option><option>CM2</option></optgroup>
            <optgroup label="Secondaire"><option>6e</option><option>5e</option><option>4e</option><option>3e</option><option>2nde</option><option>1re</option><option>Terminale</option></optgroup>
          </select>
        </label>
        <label class="field"><span>Centre souhaité</span><select name="centre"><option>Pissy</option><option>Tampouy</option><option>Saaba</option><option>SIAO</option><option>Nagrin</option><option>Je ne sais pas encore</option></select></label>
      </div>
      <label class="field"><span>Votre demande concerne</span>
        <select name="objet">
          <optgroup label="Cours">
            <option>Des cours d’appui</option>
            <option>Des cours de remédiation en mathématiques</option>
            <option>Des cours d’anglais (6e et 5e)</option>
            <option>Le Camp Vacances</option>
            <option>La préparation d’un examen</option>
          </optgroup>
          <optgroup label="Nos productions">
            <option>Les manuels de la Collection Hakili Lab</option>
            <option>L’application Amira</option>
            <option>Dr Maya (diagnostic et remédiation)</option>
          </optgroup>
          <option>Autre</option>
        </select>
      </label>
      <label class="field"><span>Votre message</span><textarea name="message" placeholder="Décrivez en quelques lignes les difficultés de votre enfant"></textarea></label>

      <label class="form-honeypot" aria-hidden="true">Ne pas remplir<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off"></label>
      <input type="hidden" name="access_key" value={web3formsKey}>
      <input type="hidden" name="subject" value="Nouvelle demande d’inscription - Hakili Lab">
      <input type="hidden" name="from_name" value="Formulaire du site Hakili Lab">

      <div class="form-actions">
        <button class="btn btn-green btn-compact" type="button" id="whatsappBtn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.85.5 3.58 1.35 5.07L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.79 14.06c-.24.68-1.19 1.24-1.95 1.4-.53.11-1.22.2-3.55-.76-2.98-1.23-4.9-4.24-5.05-4.44-.15-.2-1.21-1.6-1.21-3.06s.76-2.16 1.03-2.46c.27-.3.6-.37.8-.37.2 0 .4.002.57.01.18.008.43-.07.67.51.24.6.83 2.06.9 2.21.07.15.11.32.02.52-.09.2-.14.32-.28.5-.14.17-.29.38-.42.51-.14.14-.28.29-.12.57.16.28.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.22 1.37.28.14.44.12.61-.07.17-.19.71-.83.9-1.11.19-.28.38-.24.63-.14.26.09 1.64.77 1.92.91.28.14.47.21.54.33.07.12.07.68-.17 1.36z"/></svg>Envoyer sur WhatsApp</button>
        <button class="btn btn-outline btn-compact" type="submit" id="contactEmailBtn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>Envoyer par e-mail</button>
      </div>
      <p class="form-status" id="contactFormStatus" role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</section>
</SiteLayout>

<script>
  import '../../scripts/contact-form.js';
</script>
