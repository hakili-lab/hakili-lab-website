---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import LevelFinder from '../components/LevelFinder.astro';
import About from '../components/About.astro';
import Method from '../components/Method.astro';
import Teachers from '../components/Teachers.astro';
import Services from '../components/Services.astro';
import Centres from '../components/Centres.astro';
import Productions from '../components/Productions.astro';
import Testimonials from '../components/Testimonials.astro';
import Brochure from '../components/Brochure.astro';
import Gallery from '../components/Gallery.astro';
import Blog from '../components/Blog.astro';
import Faq from '../components/Faq.astro';
import Partners from '../components/Partners.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import DetailModal from '../components/DetailModal.astro';
---
<BaseLayout>
<TopBar />

<Header />

<Hero />

<LevelFinder />

<About />

<Method />

<Teachers />

<Services />

<Centres />

<Productions />

<Testimonials />

<Brochure />

<Gallery />

<Blog />

<Faq />

<Partners />

<Contact />

<Footer />

<DetailModal />

<script>
  import '../scripts/nav.js';
  import '../scripts/level-finder.js';
  import '../scripts/detail-modal.js';
  import '../scripts/hero-slideshow.js';
  import '../scripts/contact-form.js';
  import '../scripts/brochure-form.js';
</script>
</BaseLayout>
