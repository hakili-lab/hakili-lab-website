---
import photoA from '../assets/photos/846A26820.jpg';
import photoB from '../assets/photos/846A2755.jpg';
import photoC from '../assets/photos/banner1.jpg';
---
<section class="section" id="galerie">
  <div class="wrap">
    <span class="eyebrow">Galerie</span>
    <h2 class="h2">La vie dans nos centres</h2>
    <div class="gallery">
      <figure><img src={photoA.src} alt="Elèves en séance de travail"></figure>
      <figure><img src={photoB.src} alt="Enseignant au tableau"></figure>
      <figure><img src={photoC.src} alt="Vue d'un centre Hakili Lab"></figure>
      <figure><img src={photoB.src} alt="Travail en petit groupe"></figure>
      <figure><img src={photoA.src} alt="Remise des prix du concours de mathématiques"></figure>
    </div>
  </div>
</section>
