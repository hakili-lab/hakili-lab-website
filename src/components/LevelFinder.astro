<div class="finder">
  <div class="wrap">
    <div class="finder-card">
      <div class="finder-title">Où en est votre enfant ?</div>
      <p class="finder-sub">Choisissez son cycle, puis sa classe.</p>

      <div class="cycles" id="cycles">
        <button class="cycle is-active" data-c="prim">Primaire</button>
        <button class="cycle" data-c="sec">Secondaire</button>
      </div>

      <div class="classes is-shown" data-c="prim">
        <button class="klass is-active" data-k="cp1">CP1</button>
        <button class="klass" data-k="cp2">CP2</button>
        <button class="klass" data-k="ce1">CE1</button>
        <button class="klass" data-k="ce2">CE2</button>
        <button class="klass" data-k="cm1">CM1</button>
        <button class="klass" data-k="cm2">CM2</button>
      </div>
      <div class="classes" data-c="sec">
        <button class="klass is-active" data-k="s6">6<sup>e</sup></button>
        <button class="klass" data-k="s5">5<sup>e</sup></button>
        <button class="klass" data-k="s4">4<sup>e</sup></button>
        <button class="klass" data-k="s3">3<sup>e</sup></button>
        <button class="klass" data-k="s2">2<sup>nde</sup></button>
        <button class="klass" data-k="s1">1<sup>re</sup></button>
        <button class="klass" data-k="st">Terminale</button>
      </div>

      <div class="level-panel">
        <div>
          <h3 id="lvTitle">CP1</h3>
          <p id="lvDesc">Premiers apprentissages du nombre et du calcul, dans un cadre rassurant et très progressif.</p>
        </div>
        <div class="level-fact"><span>Matières</span><b id="lvMat">Mathématiques</b></div>
        <div class="level-fact"><span>Objectif</span><b id="lvObj">Bases du nombre</b></div>
        <a class="btn btn-primary btn-sm" href="#contact">Voir les horaires</a>
      </div>
    </div>

    <div class="stats">
      <div class="stat"><b>5</b><span>centres à Ouagadougou</span></div>
      <div class="stat"><b>79+</b><span>enseignants formés aux méthodes modernes</span></div>
      <div class="stat"><b>2</b><span>matières : maths et physique-chimie</span></div>
      <div class="stat"><b>2020</b><span>année de création de Hakili Lab</span></div>
    </div>
  </div>
</div>
