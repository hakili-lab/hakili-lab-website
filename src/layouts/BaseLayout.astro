---
import '../styles/main.css';
import { SITE_URL, SITE_TITLE, SITE_DESCRIPTION } from '../data/site.js';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: object | object[];
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, jsonLd } = Astro.props;
const canonicalUrl = SITE_URL + Astro.url.pathname;

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'Hakili Lab',
  description: SITE_DESCRIPTION,
  url: SITE_URL,
  email: 'info@hakililab.com',
  telephone: ['+22657919191', '+22658795050'],
  areaServed: {
    '@type': 'City',
    name: 'Ouagadougou',
  },
  sameAs: [
    'https://web.facebook.com/hakililab',
    'https://www.tiktok.com/@hakililab',
  ],
};

const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const jsonLdBlocks = [organizationJsonLd, ...extraJsonLd];
---
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>

<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.png" sizes="32x32" type="image/png">
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">

<!-- TODO(url): domaine de production a renseigner dans src/data/site.js (SITE_URL) ET dans astro.config.mjs (site) ; canonical/OG/JSON-LD/sitemap se completent automatiquement une fois cette valeur remplacee -->
<link rel="canonical" href={canonicalUrl}>

<meta property="og:type" content="website">
<meta property="og:site_name" content="Hakili Lab">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:locale" content="fr_FR">
<!-- TODO(url): image de partage Open Graph (1200x630) - a ajouter une fois une vraie photo disponible, puis <meta property="og:image" content="..."> -->

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<!-- TODO(url): meme image que og:image pour <meta name="twitter:image" content="..."> -->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@1,600&display=swap" rel="stylesheet">

{jsonLdBlocks.map((block) => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
))}
</head>
<body>
<a class="skip-link" href="#contenu">Aller au contenu</a>
<slot />
</body>
</html>
